<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
        Semantic tokens. Everything else in the theme paints through these names, so the
        palette can be retuned in one place. The neutrals carry a deliberate blue bias so
        surfaces read as slate rather than as flat grey.
    -->

    <!-- Grounds -->
    <Color x:Key="Color.Bg.Base">#FF0E151D</Color>
    <Color x:Key="Color.Bg.Surface">#FF151F2A</Color>
    <Color x:Key="Color.Bg.Elevated">#FF1C2836</Color>
    <Color x:Key="Color.Bg.Overlay">#FF223040</Color>
    <Color x:Key="Color.Bg.Input">#FF111A24</Color>

    <!-- Lines -->
    <Color x:Key="Color.Border.Subtle">#FF223040</Color>
    <Color x:Key="Color.Border.Strong">#FF31435A</Color>

    <!-- Text -->
    <Color x:Key="Color.Text.Primary">#FFE5EBF1</Color>
    <Color x:Key="Color.Text.Secondary">#FFA8B8C8</Color>
    <Color x:Key="Color.Text.Muted">#FF7C8FA3</Color>
    <Color x:Key="Color.Text.OnAccent">#FF06222A</Color>

    <!-- Accent -->
    <Color x:Key="Color.Accent">#FF4FD3DE</Color>
    <Color x:Key="Color.Accent.Hover">#FF7AE2EB</Color>
    <Color x:Key="Color.Accent.Pressed">#FF35B2BD</Color>
    <Color x:Key="Color.Accent.Dim">#FF1B4149</Color>

    <!-- Status -->
    <Color x:Key="Color.Success">#FF56C98A</Color>
    <Color x:Key="Color.Warning">#FFE09750</Color>
    <Color x:Key="Color.Danger">#FFE0605F</Color>

    <SolidColorBrush x:Key="Brush.Bg.Base" Color="{StaticResource Color.Bg.Base}" />
    <SolidColorBrush x:Key="Brush.Bg.Surface" Color="{StaticResource Color.Bg.Surface}" />
    <SolidColorBrush x:Key="Brush.Bg.Elevated" Color="{StaticResource Color.Bg.Elevated}" />
    <SolidColorBrush x:Key="Brush.Bg.Overlay" Color="{StaticResource Color.Bg.Overlay}" />
    <SolidColorBrush x:Key="Brush.Bg.Input" Color="{StaticResource Color.Bg.Input}" />

    <SolidColorBrush x:Key="Brush.Border.Subtle" Color="{StaticResource Color.Border.Subtle}" />
    <SolidColorBrush x:Key="Brush.Border.Strong" Color="{StaticResource Color.Border.Strong}" />

    <SolidColorBrush x:Key="Brush.Text.Primary" Color="{StaticResource Color.Text.Primary}" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="{StaticResource Color.Text.Secondary}" />
    <SolidColorBrush x:Key="Brush.Text.Muted" Color="{StaticResource Color.Text.Muted}" />
    <SolidColorBrush x:Key="Brush.Text.OnAccent" Color="{StaticResource Color.Text.OnAccent}" />

    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.Accent.Hover" Color="{StaticResource Color.Accent.Hover}" />
    <SolidColorBrush x:Key="Brush.Accent.Pressed" Color="{StaticResource Color.Accent.Pressed}" />
    <SolidColorBrush x:Key="Brush.Accent.Dim" Color="{StaticResource Color.Accent.Dim}" />

    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" />
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" />

    <!-- Metrics -->
    <CornerRadius x:Key="Radius.Small">3</CornerRadius>
    <CornerRadius x:Key="Radius.Medium">5</CornerRadius>
    <CornerRadius x:Key="Radius.Large">8</CornerRadius>

    <sys:Double x:Key="Size.Text.Caption">11</sys:Double>
    <sys:Double x:Key="Size.Text.Body">13</sys:Double>
    <sys:Double x:Key="Size.Text.Title">16</sys:Double>
    <sys:Double x:Key="Size.Text.Display">22</sys:Double>

    <FontFamily x:Key="Font.Ui">Segoe UI Variable Text, Segoe UI, Tahoma</FontFamily>
    <FontFamily x:Key="Font.Display">Segoe UI Variable Display, Segoe UI Semibold, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas, Courier New</FontFamily>

</ResourceDictionary>
