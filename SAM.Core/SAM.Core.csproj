<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyTitle>Steam Achievement Manager Core</AssemblyTitle>
    <Description>Caching, Steam services and view models for the Steam Achievement Manager.</Description>
  </PropertyGroup>
  <PropertyGroup>
    <!-- No presentation framework here by design: this assembly is consumed by the WPF
         shells but must never depend on one. -->
    <UseWPF>false</UseWPF>
    <UseWindowsForms>false</UseWindowsForms>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SAM.API\SAM.API.csproj" />
  </ItemGroup>
</Project>
