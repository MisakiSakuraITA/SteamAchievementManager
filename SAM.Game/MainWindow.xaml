<ui:ThemedWindow x:Class="SAM.Game.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="clr-namespace:SAM.UI;assembly=SAM.UI"
                 xmlns:controls="clr-namespace:SAM.UI.Controls;assembly=SAM.UI"
                 xmlns:conv="clr-namespace:SAM.UI.Converters;assembly=SAM.UI"
                 xmlns:vm="clr-namespace:SAM.Core.ViewModels;assembly=SAM.Core"
                 Title="Steam Achievement Manager"
                 Icon="pack://application:,,,/SAM.Game;component/SAM.ico"
                 Width="1120" Height="760"
                 MinWidth="720" MinHeight="480"
                 WindowStartupLocation="CenterScreen"
                 PreviewKeyDown="OnWindowPreviewKeyDown">

    <Window.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVisible" />
        <conv:BooleanToVisibilityConverter x:Key="BoolToCollapsed" Invert="True" />
        <conv:HasValueToVisibilityConverter x:Key="HasValue" />
        <conv:HasValueToVisibilityConverter x:Key="EmptyToCollapsed" Invert="True" />
        <conv:InverseBooleanConverter x:Key="Not" />
        <conv:EnumToBooleanConverter x:Key="EnumToBool" />

        <!-- ============================ achievement card ============================ -->

        <DataTemplate x:Key="AchievementCardTemplate" DataType="{x:Type vm:AchievementViewModel}">
            <Border Margin="5"
                    Background="{StaticResource Brush.Bg.Surface}"
                    BorderBrush="{StaticResource Brush.Border.Subtle}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10">
                <Border.Style>
                    <Style TargetType="{x:Type Border}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsUnlocked}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent.Dim}" />
                                <Setter Property="Background" Value="{StaticResource Brush.Bg.Elevated}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsModified}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource Brush.Warning}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- icon -->
                    <Border Grid.Column="0"
                            Width="56" Height="56"
                            VerticalAlignment="Top"
                            Background="{StaticResource Brush.Bg.Input}"
                            CornerRadius="4"
                            ClipToBounds="True">
                        <Grid>
                            <Path Style="{StaticResource Icon.Stroked}"
                                  Width="20" Height="20"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Data="{StaticResource Icon.Lock}"
                                  Stroke="{StaticResource Brush.Text.Muted}"
                                  Opacity="0.5" />
                            <controls:CachedImage Cache="{Binding Icons, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  CacheIdentity="{Binding IconIdentity}"
                                                  SourceUri="{Binding IconUri}"
                                                  DecodeWidth="56"
                                                  Stretch="UniformToFill"
                                                  RenderOptions.BitmapScalingMode="HighQuality" />
                        </Grid>
                    </Border>

                    <!-- text -->
                    <StackPanel Grid.Column="1" Margin="12,0,10,0">
                        <TextBlock Style="{StaticResource Text.Body}"
                                   FontWeight="SemiBold"
                                   Text="{Binding Name}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Id}" />
                        <TextBlock Style="{StaticResource Text.Caption}"
                                   Margin="0,3,0,0"
                                   Text="{Binding Description}"
                                   TextWrapping="Wrap"
                                   MaxHeight="30"
                                   TextTrimming="CharacterEllipsis" />

                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <TextBlock Style="{StaticResource Text.Mono}"
                                       Text="{Binding UnlockTimeText}"
                                       Foreground="{StaticResource Brush.Success}"
                                       Visibility="{Binding UnlockTimeText, Converter={StaticResource HasValue}}" />

                            <Border Background="{StaticResource Brush.Bg.Overlay}"
                                    CornerRadius="3"
                                    Padding="5,1"
                                    Visibility="{Binding IsProtected, Converter={StaticResource BoolToVisible}}"
                                    ToolTip="Steam marks this achievement as protected; it cannot be changed here.">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource Icon.Stroked}"
                                          Width="9" Height="9"
                                          Data="{StaticResource Icon.Lock}"
                                          Stroke="{StaticResource Brush.Warning}" />
                                    <TextBlock Style="{StaticResource Text.Label}"
                                               Margin="4,0,0,0"
                                               Text="PROTECTED"
                                               Foreground="{StaticResource Brush.Warning}" />
                                </StackPanel>
                            </Border>

                            <Border Background="{StaticResource Brush.Bg.Overlay}"
                                    CornerRadius="3"
                                    Margin="5,0,0,0"
                                    Padding="5,1"
                                    Visibility="{Binding IsHidden, Converter={StaticResource BoolToVisible}}">
                                <TextBlock Style="{StaticResource Text.Label}" Text="HIDDEN" />
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- state -->
                    <CheckBox Grid.Column="2"
                              VerticalAlignment="Top"
                              IsChecked="{Binding IsUnlocked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              ToolTip="Unlock this achievement on the next store"
                              AutomationProperties.Name="{Binding Name, StringFormat={}Unlock {0}}">
                        <CheckBox.Style>
                            <Style TargetType="{x:Type CheckBox}" BasedOn="{StaticResource {x:Type CheckBox}}">
                                <Setter Property="IsEnabled" Value="{Binding IsProtected, Converter={StaticResource Not}}" />
                                <Style.Triggers>
                                    <!-- Nothing can be staged once the pipe is gone. -->
                                    <DataTrigger Binding="{Binding DataContext.IsSteamDisconnected, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </CheckBox.Style>
                    </CheckBox>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- ============================ statistic row ============================ -->

        <DataTemplate x:Key="StatisticRowTemplate" DataType="{x:Type vm:StatViewModel}">
            <Border Margin="0,0,0,1"
                    Background="{StaticResource Brush.Bg.Surface}"
                    Padding="14,9">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="150" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Text.Body}"
                                   Text="{Binding DisplayName}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Style="{StaticResource Text.Mono}"
                                   Margin="0,2,0,0"
                                   Text="{Binding Id}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Style="{StaticResource Text.Caption}"
                                   Margin="0,3,0,0"
                                   Foreground="{StaticResource Brush.Danger}"
                                   Text="{Binding ValidationError}"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding HasError, Converter={StaticResource BoolToVisible}}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="10,0">
                        <Border Background="{StaticResource Brush.Bg.Overlay}"
                                CornerRadius="3"
                                Padding="6,2">
                            <TextBlock Style="{StaticResource Text.Label}" Text="{Binding TypeName}" />
                        </Border>
                        <Border Background="{StaticResource Brush.Bg.Overlay}"
                                CornerRadius="3"
                                Margin="5,0,0,0"
                                Padding="6,2"
                                Visibility="{Binding Extra, Converter={StaticResource HasValue}}">
                            <TextBlock Style="{StaticResource Text.Label}"
                                       Text="{Binding Extra}"
                                       Foreground="{StaticResource Brush.Warning}" />
                        </Border>
                    </StackPanel>

                    <TextBox Grid.Column="2"
                             VerticalAlignment="Center"
                             Text="{Binding ValueText, UpdateSourceTrigger=PropertyChanged}"
                             TextAlignment="Right"
                             FontFamily="{StaticResource Font.Mono}">
                        <TextBox.Style>
                            <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
                                <Setter Property="IsEnabled"
                                        Value="{Binding DataContext.AllowStatEditing, RelativeSource={RelativeSource AncestorType=Window}}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsProtected}" Value="True">
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                    <!-- Nothing can be staged once the pipe is gone. -->
                                    <DataTrigger Binding="{Binding DataContext.IsSteamDisconnected, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HasError}" Value="True">
                                        <Setter Property="BorderBrush" Value="{StaticResource Brush.Danger}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsModified}" Value="True">
                                        <Setter Property="BorderBrush" Value="{StaticResource Brush.Warning}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================ steam disconnected ============================ -->

        <Border Grid.Row="0"
                Style="{StaticResource Banner.Danger}"
                Visibility="{Binding IsSteamDisconnected, Converter={StaticResource BoolToVisible}}">
            <StackPanel Orientation="Horizontal">
                <Path Style="{StaticResource Icon.Stroked}"
                      VerticalAlignment="Center"
                      Data="{StaticResource Icon.Warning}"
                      Stroke="{StaticResource Brush.Danger}" />
                <TextBlock Style="{StaticResource Text.Banner}"
                           Margin="10,0,0,0"
                           Text="{Binding DisconnectedMessage}" />
            </StackPanel>
        </Border>

        <!-- ============================ notification ============================ -->

        <controls:NotificationBanner x:Name="_Notification" Grid.Row="1" />

        <!-- ============================ header ============================ -->

        <Border Grid.Row="2"
                Background="{StaticResource Brush.Bg.Surface}"
                Padding="18,14,18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Style="{StaticResource Text.Display}"
                               Text="{Binding GameName}"
                               TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Style="{StaticResource Text.Mono}" Text="App " />
                        <TextBlock Style="{StaticResource Text.Mono}" Text="{Binding AppId}" />
                        <TextBlock Style="{StaticResource Text.Mono}" Margin="10,0,0,0" Text="&#183;" />
                        <TextBlock Style="{StaticResource Text.Mono}"
                                   Margin="10,0,0,0"
                                   Text="{Binding StatisticCount, StringFormat={}{0} statistics}" />
                    </StackPanel>
                </StackPanel>

                <!-- completion -->
                <StackPanel Grid.Column="1" Width="260" VerticalAlignment="Center">
                    <Grid>
                        <TextBlock Style="{StaticResource Text.Label}"
                                   HorizontalAlignment="Left"
                                   Text="{Binding CompletionText}" />
                        <TextBlock Style="{StaticResource Text.Label}"
                                   HorizontalAlignment="Right"
                                   Foreground="{StaticResource Brush.Accent}"
                                   Text="{Binding CompletionPercentage, StringFormat={}{0:F0}%}" />
                    </Grid>
                    <ProgressBar Style="{StaticResource Progress.Completion}"
                                 Margin="0,6,0,0"
                                 Value="{Binding CompletionPercentage, Mode=OneWay}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================ tabs ============================ -->

        <TabControl Grid.Row="3">
            <TabItem Header="_Achievements">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- achievement toolbar -->
                    <Border Grid.Row="0"
                            Background="{StaticResource Brush.Bg.Base}"
                            BorderBrush="{StaticResource Brush.Border.Subtle}"
                            BorderThickness="0,0,0,1"
                            Padding="14,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MaxWidth="320" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" MinWidth="210">
                                <TextBox x:Name="_SearchBox"
                                         Padding="32,5,10,5"
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=150}" />
                                <Path Style="{StaticResource Icon.Stroked}"
                                      Margin="10,0,0,0"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Center"
                                      Data="{StaticResource Icon.Search}"
                                      Stroke="{StaticResource Brush.Text.Muted}"
                                      IsHitTestVisible="False" />
                                <TextBlock Style="{StaticResource Text.Caption}"
                                           Margin="33,0,10,0"
                                           VerticalAlignment="Center"
                                           Text="Search achievements"
                                           TextTrimming="CharacterEllipsis"
                                           IsHitTestVisible="False"
                                           Visibility="{Binding SearchText, Converter={StaticResource EmptyToCollapsed}}" />
                            </Grid>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                                <ToggleButton Style="{StaticResource Toggle.Segment}"
                                              Content="All"
                                              IsChecked="{Binding Filter, Converter={StaticResource EnumToBool}, ConverterParameter=All}" />
                                <ToggleButton Style="{StaticResource Toggle.Segment}"
                                              Content="Locked"
                                              IsChecked="{Binding Filter, Converter={StaticResource EnumToBool}, ConverterParameter=Locked}" />
                                <ToggleButton Style="{StaticResource Toggle.Segment}"
                                              Content="Unlocked"
                                              IsChecked="{Binding Filter, Converter={StaticResource EnumToBool}, ConverterParameter=Unlocked}" />
                            </StackPanel>

                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Command="{Binding UnlockAllCommand}" ToolTip="Mark every listed achievement unlocked">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource Icon.Stroked}" Data="{StaticResource Icon.Unlock}" />
                                        <AccessText Margin="7,0,0,0" Text="_Unlock all" />
                                    </StackPanel>
                                </Button>
                                <Button Margin="6,0,0,0" Command="{Binding LockAllCommand}" ToolTip="Mark every listed achievement locked">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource Icon.Stroked}" Data="{StaticResource Icon.Lock}" />
                                        <AccessText Margin="7,0,0,0" Text="_Lock all" />
                                    </StackPanel>
                                </Button>
                                <Button Margin="6,0,0,0"
                                        Command="{Binding InvertAllCommand}"
                                        ToolTip="Flip every listed achievement"
                                        AutomationProperties.Name="Flip every listed achievement">
                                    <Path Style="{StaticResource Icon.Stroked}" Data="{StaticResource Icon.Invert}" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ListBox Grid.Row="1"
                             Style="{StaticResource ListBox.Plain}"
                             Padding="9"
                             ItemsSource="{Binding Achievements}"
                             ItemTemplate="{StaticResource AchievementCardTemplate}"
                             ItemContainerStyle="{StaticResource ListBoxItem.Row}"
                             ScrollViewer.CanContentScroll="True"
                             KeyboardNavigation.DirectionalNavigation="Contained">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <!-- VirtualizationMode is declared here, on the panel itself,
                                     rather than on the ListBox: ListBox.Plain asks for
                                     Recycling, which is correct for the Statistics list below
                                     (a plain VirtualizingStackPanel) but not honoured by this
                                     panel (see its own remarks), so it is stated explicitly at
                                     the point this panel is actually used. -->
                                <controls:VirtualizingWrapPanel ItemWidth="368" ItemHeight="106"
                                                                 VirtualizingPanel.VirtualizationMode="Standard" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>
                </Grid>
            </TabItem>

            <TabItem Header="Statis_tics">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="{StaticResource Brush.Bg.Base}"
                            BorderBrush="{StaticResource Brush.Border.Subtle}"
                            BorderThickness="0,0,0,1"
                            Padding="14,10">
                        <Grid>
                            <CheckBox HorizontalAlignment="Left"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding AllowStatEditing}"
                                      Content="I understand that editing statistics can break games" />
                            <Button HorizontalAlignment="Right"
                                    Style="{StaticResource Button.Danger}"
                                    Command="{Binding ResetAllCommand}"
                                    ToolTip="Ask Steam to reset every statistic for this game">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource Icon.Stroked}"
                                          Data="{StaticResource Icon.Reset}"
                                          Stroke="{StaticResource Brush.Danger}" />
                                    <AccessText Margin="7,0,0,0" Text="R_eset all stats" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <ListBox Grid.Row="1"
                             Style="{StaticResource ListBox.Plain}"
                             Padding="14,10"
                             ItemsSource="{Binding Statistics}"
                             ItemTemplate="{StaticResource StatisticRowTemplate}"
                             ItemContainerStyle="{StaticResource ListBoxItem.Row}"
                             KeyboardNavigation.DirectionalNavigation="Contained" />
                </Grid>
            </TabItem>
        </TabControl>

        <!-- ============================ status ============================ -->

        <Border Grid.Row="4"
                Background="{StaticResource Brush.Bg.Surface}"
                BorderBrush="{StaticResource Brush.Border.Subtle}"
                BorderThickness="0,1,0,0"
                Padding="14,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ProgressBar Grid.Column="0"
                             Width="80" Height="4"
                             Margin="0,0,10,0"
                             VerticalAlignment="Center"
                             IsIndeterminate="True"
                             Style="{StaticResource Progress.Completion}"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisible}}" />

                <TextBlock Grid.Column="1"
                           Style="{StaticResource Text.Secondary}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           AutomationProperties.LiveSetting="Polite"
                           Text="{Binding Status}" />

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,12,0"
                            Visibility="{Binding IsModified, Converter={StaticResource BoolToVisible}}">
                    <Path Style="{StaticResource Icon.Stroked}"
                          Width="13" Height="13"
                          Data="{StaticResource Icon.Warning}"
                          Stroke="{StaticResource Brush.Warning}" />
                    <TextBlock Style="{StaticResource Text.Caption}"
                               Margin="7,0,0,0"
                               Foreground="{StaticResource Brush.Warning}"
                               Text="{Binding ModifiedCount, StringFormat={}{0} pending}" />
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <Button Style="{StaticResource Button.Ghost}" Command="{Binding ReloadCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Icon.Stroked}" Data="{StaticResource Icon.Refresh}" />
                            <AccessText Margin="7,0,0,0" Text="_Reload" />
                        </StackPanel>
                    </Button>
                    <Button Margin="8,0,0,0"
                            Style="{StaticResource Button.Accent}"
                            Command="{Binding StoreCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Icon.Stroked}"
                                  Data="{StaticResource Icon.Save}"
                                  Stroke="{StaticResource Brush.Text.OnAccent}" />
                            <AccessText Margin="7,0,0,0" Text="_Store changes" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:ThemedWindow>
