<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyTitle>Steam Achievement Manager API</AssemblyTitle>
    <Description>The Steam client interop layer for the Steam Achievement Manager.</Description>
  </PropertyGroup>
  <PropertyGroup>
    <!-- steamclient.dll's exports are unmanaged, so the interop layer that calls them needs
         pointer arithmetic the rest of the solution has no reason to allow. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
</Project>
